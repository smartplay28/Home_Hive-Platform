# ──────────────────────────────────────────────────────────────────────────────
# HomeHive — Environment Variables Template
# Copy this file to .env and fill in your values.
# NEVER commit the actual .env file to git — only commit this .env.example.
# ──────────────────────────────────────────────────────────────────────────────

# ── MongoDB Atlas ─────────────────────────────────────────────────────────────
# Create a free cluster at https://cloud.mongodb.com
# Format: mongodb+srv://<user>:<password>@<cluster>.mongodb.net/<dbname>
MONGO_URI=mongodb+srv://YOUR_USER:YOUR_PASSWORD@cluster0.xxxxx.mongodb.net/Urban_Crap?retryWrites=true&w=majority

# ── JWT ───────────────────────────────────────────────────────────────────────
# Generate a strong secret: openssl rand -base64 64
JWT_SECRET=REPLACE_WITH_A_STRONG_RANDOM_SECRET_AT_LEAST_64_CHARS_LONG

# ── Redis ─────────────────────────────────────────────────────────────────────
REDIS_HOST=localhost
REDIS_PORT=6379

# ── AI Service ────────────────────────────────────────────────────────────────
# Shared secret between the Spring Boot backend and the FastAPI AI service.
# Generate: python -c "import secrets; print(secrets.token_hex(32))"
AI_SERVICE_API_KEY=REPLACE_WITH_RANDOM_HEX_KEY
AI_SERVICE_URL=http://localhost:8000
